generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  HOUSING
  TRANSPORTATION
  FOOD
  UTILITIES
  INSURANCE
  MEDICAL
  SAVINGS
  PERSONAL
  ENTERTAINMENT
  SUBSCRIPTIONS
  DEBT
  OTHER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model Account {
  id        String   @id @default(cuid())
  name      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  @@map("accounts")
}

model CreditCard {
  id             String   @id @default(cuid())
  name           String
  balance        Float    @default(0)
  creditLimit    Float    @default(0)
  minimumPayment Float    @default(0)
  dueDate        Int
  createdAt      DateTime @default(now())

  @@map("credit_cards")
}

model Template {
  id         String    @id @default(cuid())
  name       String
  amount     Float
  frequency  Frequency @default(MONTHLY)
  isAutoPay  Boolean   @default(false)
  category   Category
  createdAt  DateTime  @default(now())
  dayOfMonth Int?
  lastPaidAt DateTime?

  @@map("templates")
}

model History {
  id             String   @id @default(cuid())
  templateId     String
  amountPaid     Float
  datePaid       DateTime @default(now())
  cycleReference DateTime
  createdAt      DateTime @default(now())

  @@map("history_records")
}

model CreditCardPaymentHistory {
  id             String   @id @default(cuid())
  creditCardId   String
  amountPaid     Float
  datePaid       DateTime @default(now())
  cycleReference DateTime
  createdAt      DateTime @default(now())

  @@map("credit_card_payment_history")
}

model PendingExpense {
  id          String   @id @default(cuid())
  description String?
  amount      Float
  createdAt   DateTime @default(now())

  @@map("pending_expenses")
}

model PaymentCarryover {
  id                   String   @id @default(cuid())
  templateId           String
  originCycleReference DateTime
  targetWeekStart      DateTime
  remainingAmount      Float
  createdAt            DateTime @default(now())

  @@unique([templateId, originCycleReference])
  @@map("payment_carryovers")
}
