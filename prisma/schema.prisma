generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  HOUSING
  TRANSPORTATION
  FOOD
  UTILITIES
  INSURANCE
  MEDICAL
  SAVINGS
  PERSONAL
  ENTERTAINMENT
  SUBSCRIPTIONS
  DEBT
  OTHER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  image       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspaces  WorkspaceMember[]
  ownedSpaces Workspace[]       @relation("WorkspaceOwner")
  preference  UserPreference?

  @@map("users")
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  ownerUserId String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members     WorkspaceMember[]
  preferences UserPreference[]
  invites     WorkspaceInvite[]
  accounts    Account[]
  creditCards CreditCard[]
  templates   Template[]
  history     History[]
  creditCardPaymentHistory CreditCardPaymentHistory[]
  pendingExpenses PendingExpense[]
  paymentCarryovers PaymentCarryover[]
  appSettings AppSettings?

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model UserPreference {
  id                 String     @id @default(cuid())
  userId             String     @unique
  activeWorkspaceId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id])
  activeWorkspace    Workspace? @relation(fields: [activeWorkspaceId], references: [id])

  @@map("user_preferences")
}

model Account {
  id           String    @id @default(cuid())
  name         String
  balanceCents Int       @default(0) @map("balance_cents")
  workspaceId  String
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])

  @@map("accounts")
}

model CreditCard {
  id                       String    @id @default(cuid())
  name                     String
  balanceCents             Int       @default(0) @map("balance_cents")
  creditLimitCents         Int       @default(0) @map("credit_limit_cents")
  minimumPaymentCents      Int       @default(0) @map("minimum_payment_cents")
  minimumPaymentPercentage Float?
  apr                      Float?
  dueDate                  Int
  workspaceId              String
  createdAt                DateTime  @default(now())
  lastReviewedAt           DateTime?
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("credit_cards")
}

model Template {
  id           String    @id @default(cuid())
  name         String
  amountCents  Int       @default(0) @map("amount_cents")
  frequency    Frequency @default(MONTHLY)
  isAutoPay    Boolean   @default(false)
  category     Category
  workspaceId  String
  createdAt    DateTime  @default(now())
  dayOfMonth   Int?
  lastPaidAt   DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])

  @@map("templates")
}

model History {
  id              String    @id @default(cuid())
  templateId      String
  amountPaidCents Int       @default(0) @map("amount_paid_cents")
  workspaceId     String
  datePaid        DateTime  @default(now())
  cycleReference  DateTime
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cycleReference])
  @@index([templateId, cycleReference])
  @@map("history_records")
}

model CreditCardPaymentHistory {
  id              String    @id @default(cuid())
  creditCardId    String
  amountPaidCents Int       @default(0) @map("amount_paid_cents")
  workspaceId     String
  datePaid        DateTime  @default(now())
  cycleReference  DateTime
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cycleReference])
  @@index([creditCardId, cycleReference])
  @@map("credit_card_payment_history")
}

model PendingExpense {
  id           String    @id @default(cuid())
  description  String?
  amountCents  Int       @default(0) @map("amount_cents")
  workspaceId  String
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("pending_expenses")
}

model PaymentCarryover {
  id                   String    @id @default(cuid())
  templateId           String
  originCycleReference DateTime
  targetWeekStart      DateTime
  remainingAmountCents Int       @default(0) @map("remaining_amount_cents")
  workspaceId          String
  createdAt            DateTime  @default(now())
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([templateId, originCycleReference])
  @@index([workspaceId, targetWeekStart])
  @@map("payment_carryovers")
}

model AppSettings {
  id                Int       @id @default(autoincrement())
  workspaceId       String    @unique
  weeklyIncomeCents Int       @default(100000) @map("weekly_income_cents")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("app_settings")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  workspaceId String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}
