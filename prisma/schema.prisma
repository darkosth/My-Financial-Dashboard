generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  HOUSING
  TRANSPORTATION
  FOOD
  UTILITIES
  INSURANCE
  MEDICAL
  SAVINGS
  PERSONAL
  ENTERTAINMENT
  SUBSCRIPTIONS
  DEBT
  OTHER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  image       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspaces  WorkspaceMember[]
  ownedSpaces Workspace[]       @relation("WorkspaceOwner")
  preference  UserPreference?

  @@map("users")
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  ownerUserId String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members     WorkspaceMember[]
  preferences UserPreference[]
  invites     WorkspaceInvite[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model UserPreference {
  id                 String     @id @default(cuid())
  userId             String     @unique
  activeWorkspaceId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id])
  activeWorkspace    Workspace? @relation(fields: [activeWorkspaceId], references: [id])

  @@map("user_preferences")
}

model Account {
  id          String   @id @default(cuid())
  name        String
  balance     Float    @default(0)
  workspaceId String?
  createdAt   DateTime @default(now())

  @@map("accounts")
}

model CreditCard {
  id                       String    @id @default(cuid())
  name                     String
  balance                  Float     @default(0)
  creditLimit              Float     @default(0)
  minimumPayment           Float     @default(0)
  minimumPaymentPercentage Float?
  apr                      Float?
  dueDate                  Int
  workspaceId              String?
  createdAt                DateTime  @default(now())
  lastReviewedAt           DateTime?

  @@map("credit_cards")
}

model Template {
  id          String    @id @default(cuid())
  name        String
  amount      Float
  frequency   Frequency @default(MONTHLY)
  isAutoPay   Boolean   @default(false)
  category    Category
  workspaceId String?
  createdAt   DateTime  @default(now())
  dayOfMonth  Int?
  lastPaidAt  DateTime?

  @@map("templates")
}

model History {
  id             String   @id @default(cuid())
  templateId     String
  amountPaid     Float
  workspaceId    String?
  datePaid       DateTime @default(now())
  cycleReference DateTime
  createdAt      DateTime @default(now())

  @@map("history_records")
}

model CreditCardPaymentHistory {
  id             String   @id @default(cuid())
  creditCardId   String
  amountPaid     Float
  workspaceId    String?
  datePaid       DateTime @default(now())
  cycleReference DateTime
  createdAt      DateTime @default(now())

  @@map("credit_card_payment_history")
}

model PendingExpense {
  id          String   @id @default(cuid())
  description String?
  amount      Float
  workspaceId String?
  createdAt   DateTime @default(now())

  @@map("pending_expenses")
}

model PaymentCarryover {
  id                   String   @id @default(cuid())
  templateId           String
  originCycleReference DateTime
  targetWeekStart      DateTime
  remainingAmount      Float
  workspaceId          String?
  createdAt            DateTime @default(now())

  @@unique([templateId, originCycleReference])
  @@map("payment_carryovers")
}

model AppSettings {
  id           Int      @id @default(autoincrement())
  workspaceId  String?  @unique
  weeklyIncome Float    @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("app_settings")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  workspaceId String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}
