generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  HOUSING
  TRANSPORTATION
  FOOD
  UTILITIES
  INSURANCE
  MEDICAL
  SAVINGS
  PERSONAL
  ENTERTAINMENT
  SUBSCRIPTIONS
  DEBT
  OTHER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum DataSource {
  MANUAL
  PLAID
}

enum PlaidItemStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
}

enum PlaidSyncStatus {
  PENDING
  OK
  ERROR
}

enum PlaidAccountKind {
  DEPOSITORY
  CREDIT
  LOAN
  INVESTMENT
  OTHER
}

enum PlaidImportTargetKind {
  ACCOUNT
  CREDIT_CARD
}

enum FeatureKey {
  PLAID
}

enum TelegramNotificationKind {
  TEMPLATE
  CREDIT_CARD
  CARRYOVER
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String?
  image                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspaces           WorkspaceMember[]
  ownedSpaces          Workspace[]          @relation("WorkspaceOwner")
  preference           UserPreference?
  featureGrantsCreated FeatureAccessGrant[] @relation("FeatureGrantCreatedBy")
  featureGrantsRevoked FeatureAccessGrant[] @relation("FeatureGrantRevokedBy")
  telegramConnection   TelegramConnection?
  telegramLinkTokens   TelegramLinkToken[]

  @@map("users")
}

model FeatureAccessGrant {
  id              String     @id @default(cuid())
  email           String
  feature         FeatureKey
  active          Boolean    @default(true)
  createdByUserId String
  revokedByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  revokedAt       DateTime?
  createdBy       User       @relation("FeatureGrantCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?      @relation("FeatureGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([email, feature])
  @@index([feature, active])
  @@map("feature_access_grants")
}

model Workspace {
  id                       String                     @id @default(cuid())
  name                     String
  ownerUserId              String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  owner                    User                       @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members                  WorkspaceMember[]
  preferences              UserPreference[]
  invites                  WorkspaceInvite[]
  accounts                 Account[]
  creditCards              CreditCard[]
  templates                Template[]
  history                  History[]
  creditCardPaymentHistory CreditCardPaymentHistory[]
  pendingExpenses          PendingExpense[]
  paymentCarryovers        PaymentCarryover[]
  appSettings              AppSettings?
  plaidItems               PlaidItem[]

  @@map("workspaces")
}

model WorkspaceMember {
  id                 String                          @id @default(cuid())
  userId             String
  workspaceId        String
  role               WorkspaceRole                   @default(MEMBER)
  createdAt          DateTime                        @default(now())
  user               User                            @relation(fields: [userId], references: [id])
  workspace          Workspace                       @relation(fields: [workspaceId], references: [id])
  telegramPreference TelegramNotificationPreference?

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model TelegramConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  chatId         String   @unique
  telegramUserId String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_connections")
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("telegram_link_tokens")
}

model TelegramNotificationPreference {
  id                String                         @id @default(cuid())
  workspaceMemberId String                         @unique
  enabled           Boolean                        @default(false)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  workspaceMember   WorkspaceMember                @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  deliveries        TelegramNotificationDelivery[]

  @@index([enabled])
  @@map("telegram_notification_preferences")
}

model TelegramNotificationDelivery {
  id             String                         @id @default(cuid())
  preferenceId   String
  kind           TelegramNotificationKind
  eventId        String
  occurrenceDate DateTime                       @db.Date
  leadDays       Int
  dedupeKey      String                         @unique
  status         TelegramDeliveryStatus         @default(PENDING)
  attempts       Int                            @default(0)
  sentAt         DateTime?
  lastAttemptAt  DateTime?
  lastErrorCode  String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  preference     TelegramNotificationPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@index([status, lastAttemptAt])
  @@map("telegram_notification_deliveries")
}

model UserPreference {
  id                String     @id @default(cuid())
  userId            String     @unique
  activeWorkspaceId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id])
  activeWorkspace   Workspace? @relation(fields: [activeWorkspaceId], references: [id])

  @@map("user_preferences")
}

model Account {
  id                 String              @id @default(cuid())
  name               String
  balanceCents       Int                 @default(0) @map("balance_cents")
  workspaceId        String
  source             DataSource          @default(MANUAL)
  createdAt          DateTime            @default(now())
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plaidRemoteAccount PlaidRemoteAccount? @relation("ImportedAccount")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, source])
  @@map("accounts")
}

model CreditCard {
  id                       String              @id @default(cuid())
  name                     String
  balanceCents             Int                 @default(0) @map("balance_cents")
  creditLimitCents         Int                 @default(0) @map("credit_limit_cents")
  minimumPaymentCents      Int                 @default(0) @map("minimum_payment_cents")
  minimumPaymentPercentage Float?
  apr                      Float?
  dueDate                  Int?
  workspaceId              String
  source                   DataSource          @default(MANUAL)
  createdAt                DateTime            @default(now())
  lastReviewedAt           DateTime?
  workspace                Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plaidRemoteAccount       PlaidRemoteAccount? @relation("ImportedCreditCard")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, source])
  @@map("credit_cards")
}

model PlaidItem {
  id                    String               @id @default(cuid())
  workspaceId           String
  plaidItemId           String               @unique @map("plaid_item_id")
  accessTokenCiphertext String?              @map("access_token_ciphertext")
  institutionId         String?              @map("institution_id")
  institutionName       String?              @map("institution_name")
  status                PlaidItemStatus      @default(ACTIVE)
  lastSyncStatus        PlaidSyncStatus      @default(PENDING) @map("last_sync_status")
  lastSyncedAt          DateTime?            @map("last_synced_at")
  lastSyncErrorCode     String?              @map("last_sync_error_code")
  lastSyncErrorMessage  String?              @map("last_sync_error_message")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  remoteAccounts        PlaidRemoteAccount[]

  @@index([workspaceId, status])
  @@map("plaid_items")
}

model PlaidRemoteAccount {
  id                    String                 @id @default(cuid())
  plaidItemId           String
  workspaceId           String
  plaidAccountId        String                 @unique @map("plaid_account_id")
  kind                  PlaidAccountKind
  subtype               String?
  name                  String
  officialName          String?                @map("official_name")
  mask                  String?
  isoCurrencyCode       String?                @map("iso_currency_code")
  currentBalanceCents   Int?                   @map("current_balance_cents")
  availableBalanceCents Int?                   @map("available_balance_cents")
  creditLimitCents      Int?                   @map("credit_limit_cents")
  isImported            Boolean                @default(false) @map("is_imported")
  importTargetKind      PlaidImportTargetKind? @map("import_target_kind")
  importedAccountId     String?                @unique @map("imported_account_id")
  importedCreditCardId  String?                @unique @map("imported_credit_card_id")
  lastSyncedAt          DateTime?              @map("last_synced_at")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  item                  PlaidItem              @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  importedAccount       Account?               @relation("ImportedAccount", fields: [importedAccountId], references: [id], onDelete: SetNull)
  importedCreditCard    CreditCard?            @relation("ImportedCreditCard", fields: [importedCreditCardId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isImported])
  @@index([plaidItemId])
  @@map("plaid_remote_accounts")
}

model Template {
  id          String    @id @default(cuid())
  name        String
  amountCents Int       @default(0) @map("amount_cents")
  frequency   Frequency @default(MONTHLY)
  isAutoPay   Boolean   @default(false)
  category    Category
  workspaceId String
  createdAt   DateTime  @default(now())
  dayOfMonth  Int?
  lastPaidAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("templates")
}

model History {
  id              String    @id @default(cuid())
  templateId      String
  amountPaidCents Int       @default(0) @map("amount_paid_cents")
  workspaceId     String
  datePaid        DateTime  @default(now())
  cycleReference  DateTime
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cycleReference])
  @@index([templateId, cycleReference])
  @@map("history_records")
}

model CreditCardPaymentHistory {
  id              String    @id @default(cuid())
  creditCardId    String
  amountPaidCents Int       @default(0) @map("amount_paid_cents")
  workspaceId     String
  datePaid        DateTime  @default(now())
  cycleReference  DateTime
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cycleReference])
  @@index([creditCardId, cycleReference])
  @@map("credit_card_payment_history")
}

model PendingExpense {
  id          String    @id @default(cuid())
  description String?
  amountCents Int       @default(0) @map("amount_cents")
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("pending_expenses")
}

model PaymentCarryover {
  id                   String    @id @default(cuid())
  templateId           String
  originCycleReference DateTime
  targetWeekStart      DateTime
  remainingAmountCents Int       @default(0) @map("remaining_amount_cents")
  workspaceId          String
  createdAt            DateTime  @default(now())
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([templateId, originCycleReference])
  @@index([workspaceId, targetWeekStart])
  @@map("payment_carryovers")
}

model AppSettings {
  id                Int       @id @default(autoincrement())
  workspaceId       String    @unique
  weeklyIncomeCents Int       @default(100000) @map("weekly_income_cents")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("app_settings")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  workspaceId String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}
